# =============================================================================
# Halal Trader — Environment Variables
# Copy to .env and fill in your values
# =============================================================================

# Anthropic — NEVER expose to frontend
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/halal_trader

# Auth / JWT
JWT_SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token-urlsafe-64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...
STRIPE_MANAGED_MONTHLY_PRICE_ID=price_...
STRIPE_MANAGED_ANNUAL_PRICE_ID=price_...

# Encryption for user Schwab credentials (Fernet key)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Schwab API
SCHWAB_APP_KEY=your_app_key_here
SCHWAB_APP_SECRET=your_app_secret_here
SCHWAB_CALLBACK_URL=https://127.0.0.1
SCHWAB_TOKEN_PATH=schwab_token.json

# Firebase (push notifications)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_personal_chat_id_here
TRADER_TELEGRAM_CHAT_ID=

# Data APIs
NEWS_API_KEY=your_newsapi_key_here
ZOYA_API_KEY=optional_but_recommended
FRED_API_KEY=optional_macro_data

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Trading defaults
DRY_RUN=True
AUTO_EXECUTE=False
AUTO_EXECUTE_MAX_USD=50

# App config
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000

# App identity (for Capacitor)
APP_ID=com.halaltrader.app
APP_NAME=Halal Trader
