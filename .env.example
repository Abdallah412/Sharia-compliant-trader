# Schwab API — from developer.schwab.com
SCHWAB_APP_KEY=your_app_key_here
SCHWAB_APP_SECRET=your_app_secret_here
SCHWAB_CALLBACK_URL=https://127.0.0.1
SCHWAB_TOKEN_PATH=schwab_token.json

# AI Agents
ANTHROPIC_API_KEY=your_anthropic_key_here

# Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_personal_chat_id_here
NOTIFICATION_EMAIL=optional@email.com

# Data sources
ZOYA_API_KEY=optional_but_recommended
NEWS_API_KEY=your_newsapi_key_here
FRED_API_KEY=optional_macro_data

# Trading config
DRY_RUN=True
AUTO_EXECUTE=False
AUTO_EXECUTE_MAX_USD=50

# Tax config
USER_INCOME_BRACKET=22
USER_FILING_STATUS=single
USER_STATE=CA

# Portfolio rules
MAX_POSITION_PCT_STOCK=0.20
MAX_POSITION_PCT_ETF=0.40
MIN_CASH_RESERVE_PCT=0.10
STOP_LOSS_PCT=0.08
TAKE_PROFIT_PARTIAL_PCT=0.15
TAKE_PROFIT_FULL_PCT=0.25
MIN_HOLD_DAYS=5

# Scheduler
BOT_RUN_TIME=09:35
TIMEZONE=America/New_York
API_PORT=8000
DASHBOARD_PORT=3000
