{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "${BACKEND_URL}/api/$1" },
    { "source": "/auth/(.*)", "destination": "${BACKEND_URL}/auth/$1" },
    { "source": "/payments/(.*)", "destination": "${BACKEND_URL}/payments/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
